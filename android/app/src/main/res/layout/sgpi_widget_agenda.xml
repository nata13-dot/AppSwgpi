            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/agenda_row4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/widget_tile"
