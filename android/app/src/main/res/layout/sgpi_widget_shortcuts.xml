<?xml version="1.0" encoding="utf-8"?>
<!-- Accesos rápidos (SgpiShortcutsWidget.java): hasta cuatro pantallas elegidas al colocarlo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shortcuts_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="9dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp">
        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_accent_amber"
            android:contentDescription="Accesos rápidos"
            android:padding="6dp"
            android:src="@drawable/ic_widget_bolt" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/shortcuts_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Accesos rápidos"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/shortcuts_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#BFD4F5"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/shortcuts_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_tile"
        android:gravity="center"
        android:padding="12dp"
        android:text="Abre SGPI e inicia sesión para usar los accesos."
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/shortcuts_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/shortcut1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/widget_tile"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">
                <ImageView
                android:id="@+id/shortcut_icon1"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_accent_cyan"
                android:contentDescription="@null"
                android:padding="7dp"
                android:src="@drawable/ic_widget_bolt" />
                <TextView
                    android:id="@+id/shortcut_label1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:alpha="0.6"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_arrow" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/shortcut2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/widget_tile"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">
                <ImageView
                android:id="@+id/shortcut_icon2"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_accent_cyan"
                android:contentDescription="@null"
                android:padding="7dp"
                android:src="@drawable/ic_widget_bolt" />
                <TextView
                    android:id="@+id/shortcut_label2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:alpha="0.6"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_arrow" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/shortcuts_row2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/shortcut3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/widget_tile"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">
                <ImageView
                android:id="@+id/shortcut_icon3"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_accent_cyan"
                android:contentDescription="@null"
                android:padding="7dp"
                android:src="@drawable/ic_widget_bolt" />
                <TextView
                    android:id="@+id/shortcut_label3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:alpha="0.6"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_arrow" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/shortcut4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/widget_tile"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">
                <ImageView
                android:id="@+id/shortcut_icon4"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_accent_cyan"
                android:contentDescription="@null"
                android:padding="7dp"
                android:src="@drawable/ic_widget_bolt" />
                <TextView
                    android:id="@+id/shortcut_label4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:alpha="0.6"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_arrow" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
