<?xml version="1.0" encoding="utf-8"?>
<!-- Pendiente principal (SgpiMainWidget.java): un solo dato grande con su ícono. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">
    <ImageView
        android:id="@+id/main_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_accent_amber"
        android:contentDescription="@null"
        android:padding="9dp"
        android:src="@drawable/ic_widget_bolt" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/main_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#BFD4F5"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/main_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="21sp" />
        <TextView
            android:id="@+id/main_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#BFD4F5"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
